# ΩMEGA PRIME Δ v17.0.0 — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env with live credentials.
# Live trading requires 60-day paper track record + third-party audit + legal review.

# Mode — always start in paper mode
PAPER_MODE=true

# Infrastructure
KAFKA_BROKERS=kafka:9092
REDIS_URL=redis://redis:6379
POSTGRES_DSN=postgresql://postgres:omega@postgres:5432/omega

# Risk limits
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
RISK_PER_TRADE=0.005
MAX_POSITIONS=8
MAX_NOTIONAL_PER_TRADE=50000
MAX_LEVERAGE=2.0
MIN_CONFIDENCE=0.60
STALE_BOOK_SECONDS=5
MAX_OPEN_POSITIONS=8
MAX_ASSET_EXPOSURE=0.25

# Portfolio
PORTFOLIO_EQUITY=100000

# Authentication — REQUIRED for control plane (risk-service /kill, /reset) and
# websocket-gateway. Both services REFUSE TO START without a real secret.
# Generate one with:  openssl rand -base64 48
# Then mint operator tokens with:  JWT_SECRET=<secret> python3 scripts/mint_operator_token.py --role operator
JWT_SECRET=

# Authority boundary (AEGIS→VULTURE signed approvals) — REQUIRED.
# risk-service REFUSES TO START without the private key; execution-service
# REFUSES TO START without the public key. Generate with:
#   cd apps/approval && go run ./cmd/keygen
# Never commit real keys.
AEGIS_APPROVAL_PRIVKEY=
AEGIS_APPROVAL_PUBKEY=

# Phase 4: TruthCore /append write authentication. One shared secret, set
# identically on truth-core, risk-engine, and execution-engine. Generate with:
#   openssl rand -hex 32
# risk-service and execution-service send it as a bearer token; truth-core
# rejects unauthenticated appends when it is set. Never commit the real value.
TRUTHCORE_WRITE_SECRET=

# CORS for websocket-gateway: comma-separated exact origins allowed to call the
# gateway HTTP API from a browser. Leave empty = same-origin only (fail closed).
# Example: ALLOWED_ORIGINS=https://app.example.com
ALLOWED_ORIGINS=

# Broker API keys (leave as dummy in paper mode)
KRAKEN_API_KEY=dummy
KRAKEN_API_SECRET=dummy
BINANCE_API_KEY=dummy
BINANCE_API_SECRET=dummy
COINBASE_API_KEY=dummy
COINBASE_API_SECRET=dummy
ALPACA_API_KEY=dummy
ALPACA_API_SECRET=dummy
IBKR_CLIENT_ID=0
OANDA_API_KEY=dummy
OANDA_ACCOUNT_ID=dummy

# AI / LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# WebSocket / UI
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_API_URL=http://localhost:8080
